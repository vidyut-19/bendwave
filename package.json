{
  "name": "vibedeck",
  "version": "0.9.0",
  "description": "A vibe-coded, stem-aware DJ tool: two Web Audio decks, beatgrids, auto-sync, keyboard + MIDI control.",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --strictPort\" \"wait-on tcp:5173 && electron . --dev\"",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --outdir=dist-electron --platform=node --format=cjs --external:electron",
    "postinstall": "node scripts/ensure-electron.mjs",
    "build": "npm run build:electron && vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.vidyut19.vibedeck",
    "productName": "vibedeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "notarize": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "signalsmith-stretch": "^1.3.2"
  }
}
